ription":"Percentage of 3-point Field Goals Made accounted by an individual player (MUST include Team Split. NOTE: When looking at season, it's all 3PM for a team WHEN THE PLAYER WAS ON THE ROSTER, not just games a player played in.)","formatType":"number","useLiveData":true,"sortDirectionDesc":true,"format":{"decimalPlaceCount":1,"decimalShiftCount":2,"showPlusSymbol":false,"showZeroBeforeDecimal":false,"customSuffix":"%"}},{"queryEngineMeasureKey":"player_played_losses","onAirCatalogMeasureKey":"player_played_losses","description":"Player played in game and result of the game was a loss for his team","formatType":"number","useLiveData":true,"sortDirectionDesc":true,"format":{"decimalPlaceCount":0,"decimalShiftCount":0,"showPlusSymbol":false,"showZeroBeforeDecimal":true,"customSuffix":""}},{"queryEngineMeasureKey":"player_team_wins_in_gp","onAirCatalogMeasureKey":"player_team_wins_in_gp","description":"Player played in game and result of the game was a win for his team","formatType":"number","useLiveData":true,"sortDirectionDesc":true,"format":{"decimalPlaceCount":0,"decimalShiftCount":0,"showPlusSymbol":false,"showZeroBeforeDecimal":true,"customSuffix":""}},{"queryEngineMeasureKey":"player_tech_fouls","onAirCatalogMeasureKey":"player_tech_fouls","description":"The number of technical fouls by player. This is the number that can qualify a player for an ejection in game, or a suspension during a season.","formatType":"number","useLiveData":true,"sortDirectionDesc":true,"format":{"decimalPlaceCount":0,"decimalShiftCount":0,"showPlusSymbol":false,"showZeroBeforeDecimal":true,"customSuffix":""}},{"queryEngineMeasureKey":"player_to_pct","onAirCatalogMeasureKey":"player_to_pct","description":"An estimate of turnovers per 100 plays (for individual players)","formatType":"number","useLiveData":true,"sortDirectionDesc":true,"format":{"decimalPlaceCount":1,"decimalShiftCount":0,"showPlusSymbol":false,"showZeroBeforeDecimal":true,"customSuffix":""}},{"queryEngineMeasureKey":"