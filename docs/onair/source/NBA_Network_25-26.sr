ugh turnovers and rebounding.","formatType":"number","useLiveData":true,"sortDirectionDesc":true,"format":{"decimalPlaceCount":2,"decimalShiftCount":0,"showPlusSymbol":true,"showZeroBeforeDecimal":true,"customSuffix":""}},{"queryEngineMeasureKey":"shooting_poss_diff_per_game","onAirCatalogMeasureKey":"shooting_poss_diff_per_game","description":"Net shot possessions (FGA+0.44*FTA) per game, teams compared to opponents. A measure of manufactured extra possessions through turnovers and rebounding.","formatType":"number","useLiveData":false,"sortDirectionDesc":true,"format":{"decimalPlaceCount":2,"decimalShiftCount":0,"showPlusSymbol":true,"showZeroBeforeDecimal":true,"customSuffix":""}},{"queryEngineMeasureKey":"shooting_poss_per_game","onAirCatalogMeasureKey":"shooting_poss_per_game","description":"Shooting possessions (FGA + FTA*0.44) per game.","formatType":"number","useLiveData":false,"sortDirectionDesc":true,"format":{"decimalPlaceCount":1,"decimalShiftCount":0,"showPlusSymbol":false,"showZeroBeforeDecimal":true,"customSuffix":""}},{"queryEngineMeasureKey":"shot_distance","onAirCatalogMeasureKey":"shot_distance","description":"The distance of a shot","formatType":"number","useLiveData":true,"sortDirectionDesc":true,"format":{"decimalPlaceCount":1,"decimalShiftCount":0,"showPlusSymbol":false,"showZeroBeforeDecimal":true,"customSuffix":""}},{"queryEngineMeasureKey":"shots_blocked","onAirCatalogMeasureKey":"shots_blocked","description":"The number of blocked shot attempts.","formatType":"number","useLiveData":true,"sortDirectionDesc":true,"format":{"decimalPlaceCount":0,"decimalShiftCount":0,"showPlusSymbol":false,"showZeroBeforeDecimal":true,"customSuffix":""}},{"queryEngineMeasureKey":"steal_diff","onAirCatalogMeasureKey":"steal_diff","description":"Team steals minus opposing steals","formatType":"number","useLiveData":true,"sortDirectionDesc":true,"format":{"decimalPlaceCount":0,"decimalShiftCount":0,"showPlusSymbol":true,"showZeroBeforeDecimal":true,"customSuffix