x","description":"Steals plus blocks per 36 minutes","formatType":"number","useLiveData":true,"sortDirectionDesc":true,"format":{"decimalPlaceCount":2,"decimalShiftCount":0,"showPlusSymbol":false,"showZeroBeforeDecimal":true,"customSuffix":""}},{"queryEngineMeasureKey":"team_bench_points","onAirCatalogMeasureKey":"team_bench_points","description":"Total points scored by players who did not start (Team level)","formatType":"number","useLiveData":true,"sortDirectionDesc":true,"format":{"decimalPlaceCount":0,"decimalShiftCount":0,"showPlusSymbol":false,"showZeroBeforeDecimal":true,"customSuffix":""}},{"queryEngineMeasureKey":"team_def_rating","onAirCatalogMeasureKey":"team_def_rating","description":"Estimated points allowed per 100 possessions (TEAM stat only)","formatType":"number","useLiveData":true,"sortDirectionDesc":true,"format":{"decimalPlaceCount":1,"decimalShiftCount":0,"showPlusSymbol":false,"showZeroBeforeDecimal":true,"customSuffix":""}},{"queryEngineMeasureKey":"team_fouls_drawn","onAirCatalogMeasureKey":"team_fouls_drawn","description":"Fouls drawn against the opponent.","formatType":"number","useLiveData":true,"sortDirectionDesc":true,"format":{"decimalPlaceCount":0,"decimalShiftCount":0,"showPlusSymbol":false,"showZeroBeforeDecimal":true,"customSuffix":""}},{"queryEngineMeasureKey":"team_fouls_drawn_per_game","onAirCatalogMeasureKey":"team_fouls_drawn_per_game","description":"Fouls drawn against the opponent per game.","formatType":"number","useLiveData":false,"sortDirectionDesc":true,"format":{"decimalPlaceCount":1,"decimalShiftCount":0,"showPlusSymbol":false,"showZeroBeforeDecimal":true,"customSuffix":""}},{"queryEngineMeasureKey":"team_games","onAirCatalogMeasureKey":"team_games","description":"The total number of team games.","formatType":"number","useLiveData":true,"sortDirectionDesc":true,"format":{"decimalPlaceCount":0,"decimalShiftCount":0,"showPlusSymbol":false,"showZeroBeforeDecimal":true,"customSuffix":""}},{"queryEngineMeasureKey":"team_losses","onAirCatalogMeasureKey":"team_losses","description":"The total number of team losses.","formatType":"number","useLiveData":true,"sortDirectionDesc":true,"format":{"decimalPlaceCount":0,"decimalShiftCount":0,"showPlusSymbol":false,"showZeroBeforeDecimal":true,"customSuffix":""}},{"queryEngineMeasureKey":"team_net_rating","onAirCatalogMeasureKey":"team_net_rating","description":"Estimated points scored minus points allowed per 100 possessions (TEAM stat only)","formatType":"number","useLiveData":true,"sortDirectionDesc":true,"format":{"decimalPlaceCount":1,"decimalShiftCount":0,"showPlusSymbol":false,"showZeroBeforeDecimal":true,"customSuffix":""}},{"queryEngineMeasureKey":"team_off_rating","onAirCatalogMeasureKey":"team_off_rating","description":"Estimated points scored per 100 possessions (TEAM stat only)","formatType":"number","useLiveData":true,"sortDirectionDesc":true,"format":{"decimalPlaceCount":1,"decimalShiftCount":0,"showPlusSymbol":false,"showZeroBeforeDecimal":true,"customSuffix":""}},{"queryEngineMeasureKey":"team_starter_points","onAirCatalogMeasureKey":"team_starter_points","description":"Total points scored by players who were in the starting lineup.","formatType":"number","useLiveData":true,"sortDirectionDesc":true,"format":{"decimalPlaceCount":0,"decimalShiftCount":0,"showPlusSymbol":false,"showZeroBeforeDecimal":true,"customSuffix":""}},{"queryEngineMeasureKey":"team_to_per_game","onAirCatalogMeasureKey":"team_to_per_game","description":"The number of team only turnovers per game.","formatType":"number","useLiveData":false,"sortDirectionDesc":true,"format":{"decimalPlaceCount":1,"decimalShiftCount":0,"showPlusSymbol":false,"showZeroBeforeDecimal":true,"customSuffix":""}},{"queryEngineMeasureKey":"team_turnover_pct","onAirCatalogMeasureKey":"team_turnover_pct","description":"An estimate of turnovers per 100 plays","formatType":"number","useLiveData":true,"sortDirectionDesc":true,"format":{"decimalPlaceCount":1,"decimalShiftCount":0,"showPlusSymb