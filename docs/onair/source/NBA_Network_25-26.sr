nus opposing made threes.","formatType":"number","useLiveData":true,"sortDirectionDesc":true,"format":{"decimalPlaceCount":0,"decimalShiftCount":0,"showPlusSymbol":true,"showZeroBeforeDecimal":true,"customSuffix":""}},{"queryEngineMeasureKey":"three_made_diff_game","onAirCatalogMeasureKey":"three_made_diff_game","description":"The margin of three point makes to opposing three point makes per game.","formatType":"number","useLiveData":true,"sortDirectionDesc":true,"format":{"decimalPlaceCount":2,"decimalShiftCount":0,"showPlusSymbol":true,"showZeroBeforeDecimal":true,"customSuffix":""}},{"queryEngineMeasureKey":"three_made_home","onAirCatalogMeasureKey":"three_made_home","description":"3 Point Field Goals Made in home games","formatType":"number","useLiveData":true,"sortDirectionDesc":true,"format":{"decimalPlaceCount":0,"decimalShiftCount":0,"showPlusSymbol":false,"showZeroBeforeDecimal":true,"customSuffix":""}},{"queryEngineMeasureKey":"three_made_per_thirtysix","onAirCatalogMeasureKey":"three_made_per_thirtysix","description":"Made 3-pointers per 36 minutes played","formatType":"number","useLiveData":true,"sortDirectionDesc":true,"format":{"decimalPlaceCount":2,"decimalShiftCount":0,"showPlusSymbol":false,"showZeroBeforeDecimal":true,"customSuffix":""}},{"queryEngineMeasureKey":"three_misses","onAirCatalogMeasureKey":"three_misses","description":"Number of missed three point shots","formatType":"number","useLiveData":true,"sortDirectionDesc":true,"format":{"decimalPlaceCount":0,"decimalShiftCount":0,"showPlusSymbol":false,"showZeroBeforeDecimal":true,"customSuffix":""}},{"queryEngineMeasureKey":"three_pct","onAirCatalogMeasureKey":"three_pct","description":"3-point field goal percentage","formatType":"number","useLiveData":false,"sortDirectionDesc":true,"format":{"decimalPlaceCount":0,"decimalShiftCount":2,"showPlusSymbol":false,"showZeroBeforeDecimal":false,"customSuffix":"%"}},{"queryEngineMeasureKey":"three_pct_away","onAirCatalogMeasureKey":"three_pct_away","d