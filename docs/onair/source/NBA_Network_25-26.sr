 points that were second chance","formatType":"number","useLiveData":true,"sortDirectionDesc":true,"format":{"decimalPlaceCount":1,"decimalShiftCount":2,"showPlusSymbol":false,"showZeroBeforeDecimal":false,"customSuffix":"%"}},{"queryEngineMeasureKey":"pct_points_via_bench","onAirCatalogMeasureKey":"pct_points_via_bench","description":"Percentage of total team points scored by bench players.","formatType":"number","useLiveData":true,"sortDirectionDesc":true,"format":{"decimalPlaceCount":1,"decimalShiftCount":2,"showPlusSymbol":false,"showZeroBeforeDecimal":false,"customSuffix":"%"}},{"queryEngineMeasureKey":"pct_points_via_fast_break","onAirCatalogMeasureKey":"pct_points_via_fast_break","description":"Percentage of total points scored via fast break","formatType":"number","useLiveData":true,"sortDirectionDesc":true,"format":{"decimalPlaceCount":1,"decimalShiftCount":2,"showPlusSymbol":false,"showZeroBeforeDecimal":false,"customSuffix":"%"}},{"queryEngineMeasureKey":"pct_points_via_starters","onAirCatalogMeasureKey":"pct_points_via_starters","description":"Percentage of total team points scored by starters.","formatType":"number","useLiveData":true,"sortDirectionDesc":true,"format":{"decimalPlaceCount":1,"decimalShiftCount":2,"showPlusSymbol":false,"showZeroBeforeDecimal":false,"customSuffix":"%"}},{"queryEngineMeasureKey":"pct_points_via_twos","onAirCatalogMeasureKey":"pct_points_via_twos","description":"Percentage of points from made 2-pointers","formatType":"number","useLiveData":true,"sortDirectionDesc":true,"format":{"decimalPlaceCount":1,"decimalShiftCount":2,"showPlusSymbol":false,"showZeroBeforeDecimal":false,"customSuffix":"%"}},{"queryEngineMeasureKey":"pct_rebs_def","onAirCatalogMeasureKey":"pct_rebs_def","description":"Percentage of a player or team's total rebounds that were defensive rebounds.","formatType":"number","useLiveData":true,"sortDirectionDesc":true,"format":{"decimalPlaceCount":1,"decimalShiftCount":2,"showPlusSymbol":false,"showZeroBeforeDec