{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smartstat.local/tools/onair_dump/index/semantic_index.schema.json",
  "title": "SmartStat OnAir Normalized Semantic Index",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "notesField": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "semanticRecord": {
      "type": "object",
      "required": [
        "id",
        "name",
        "league",
        "source_type",
        "source_path",
        "source_ref",
        "aliases"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "league": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_type": {
          "type": "string",
          "enum": [
            "runtime",
            "lookup_index",
            "grammar",
            "schema"
          ]
        },
        "source_path": {
          "type": "string"
        },
        "source_ref": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "$ref": "#/$defs/notesField"
        }
      },
      "additionalProperties": true
    },
    "entityRecord": {
      "allOf": [
        {
          "$ref": "#/$defs/semanticRecord"
        }
      ]
    },
    "measureRecord": {
      "allOf": [
        {
          "$ref": "#/$defs/semanticRecord"
        }
      ]
    },
    "filterRecord": {
      "allOf": [
        {
          "$ref": "#/$defs/semanticRecord"
        }
      ]
    },
    "profileRecord": {
      "allOf": [
        {
          "$ref": "#/$defs/semanticRecord"
        }
      ]
    },
    "qualifierRecord": {
      "allOf": [
        {
          "$ref": "#/$defs/semanticRecord"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "generated_utc",
    "source_roots",
    "leagues",
    "entities",
    "measures",
    "qualifiers",
    "filters",
    "profiles",
    "raw_sources"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Semantic index schema version."
    },
    "generated_utc": {
      "type": "string",
      "description": "Deterministic generation marker for this scaffold."
    },
    "source_roots": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Source roots discovered under .tools/onair_dump."
    },
    "leagues": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Known leagues discovered from source paths."
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entityRecord"
      },
      "description": "Normalized entities extracted with explicit provenance."
    },
    "measures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/measureRecord"
      },
      "description": "Normalized measures extracted from runtime and lookup sources."
    },
    "qualifiers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/qualifierRecord"
      },
      "description": "Normalized qualifiers (only when source confidence is strong)."
    },
    "filters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/filterRecord"
      },
      "description": "Normalized filter records from runtime/lookup filter signals."
    },
    "profiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/profileRecord"
      },
      "description": "Normalized profile records from runtime profile payloads."
    },
    "raw_sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_files",
        "roots"
      ],
      "properties": {
        "total_files": {
          "type": "integer",
          "minimum": 0
        },
        "roots": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "exists",
              "file_count",
              "files"
            ],
            "properties": {
              "exists": {
                "type": "boolean"
              },
              "file_count": {
                "type": "integer",
                "minimum": 0
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
