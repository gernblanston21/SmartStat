{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smartstat.local/tools/onair_dump/index/semantic_index.schema.json",
  "title": "SmartStat OnAir Normalized Semantic Index",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sourceTypeValue": {
      "type": "string",
      "enum": [
        "runtime",
        "lookup_index",
        "grammar",
        "grammar_snapshot",
        "schema"
      ]
    },
    "confidenceField": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        }
      ]
    },
    "notesField": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "lineageEntry": {
      "type": "object",
      "required": [
        "source_type",
        "source_path",
        "source_ref"
      ],
      "properties": {
        "source_type": {
          "$ref": "#/$defs/sourceTypeValue"
        },
        "source_path": {
          "type": "string"
        },
        "source_ref": {
          "type": "string"
        },
        "role": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "semanticRecord": {
      "type": "object",
      "required": [
        "id",
        "name",
        "league",
        "source_type",
        "source_path",
        "source_ref",
        "aliases",
        "related_ids",
        "relationship_refs",
        "lineage",
        "evidence",
        "confidence"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "league": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_type": {
          "$ref": "#/$defs/sourceTypeValue"
        },
        "source_path": {
          "type": "string"
        },
        "source_ref": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "related_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "relationship_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lineage": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lineageEntry"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidence": {
          "$ref": "#/$defs/confidenceField"
        },
        "notes": {
          "$ref": "#/$defs/notesField"
        }
      },
      "additionalProperties": true
    },
    "relationshipRecord": {
      "type": "object",
      "required": [
        "id",
        "type",
        "from_id",
        "to_id",
        "league",
        "source_type",
        "source_path",
        "source_ref",
        "confidence"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "from_id": {
          "type": "string"
        },
        "to_id": {
          "type": "string"
        },
        "league": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_type": {
          "$ref": "#/$defs/sourceTypeValue"
        },
        "source_path": {
          "type": "string"
        },
        "source_ref": {
          "type": "string"
        },
        "confidence": {
          "$ref": "#/$defs/confidenceField"
        },
        "notes": {
          "$ref": "#/$defs/notesField"
        }
      },
      "additionalProperties": false
    },
    "traceRecord": {
      "type": "object",
      "required": [
        "lineage",
        "evidence",
        "relationship_ids"
      ],
      "properties": {
        "lineage": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lineageEntry"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "relationship_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "traceIndex": {
      "type": "object",
      "required": [
        "by_record_id",
        "by_source_path"
      ],
      "properties": {
        "by_record_id": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/traceRecord"
          }
        },
        "by_source_path": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "queryPathStep": {
      "type": "object",
      "required": [
        "kind",
        "ref_id",
        "label",
        "source_path",
        "source_ref"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "ref_id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "source_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "queryPathRecord": {
      "type": "object",
      "required": [
        "id",
        "league",
        "entry_record_id",
        "path_type",
        "steps",
        "terminal_record_ids",
        "source_evidence",
        "confidence"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "league": {
          "type": [
            "string",
            "null"
          ]
        },
        "entry_record_id": {
          "type": "string"
        },
        "path_type": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/queryPathStep"
          }
        },
        "terminal_record_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidence": {
          "$ref": "#/$defs/confidenceField"
        },
        "notes": {
          "$ref": "#/$defs/notesField"
        }
      },
      "additionalProperties": false
    },
    "sourceTreeNode": {
      "type": "object",
      "required": [
        "id",
        "label",
        "node_type",
        "source_type",
        "source_path",
        "league",
        "record_ids",
        "children"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "node_type": {
          "type": "string",
          "enum": [
            "source_type_root",
            "league_bucket",
            "misc_bucket",
            "source_file"
          ]
        },
        "source_type": {
          "$ref": "#/$defs/sourceTypeValue"
        },
        "source_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "league": {
          "type": [
            "string",
            "null"
          ]
        },
        "record_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceTreeNode"
          }
        }
      },
      "additionalProperties": false
    },
    "sourceTree": {
      "type": "object",
      "required": [
        "roots"
      ],
      "properties": {
        "roots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceTreeNode"
          }
        }
      },
      "additionalProperties": false
    },
    "uiViews": {
      "type": "object",
      "required": [
        "by_league",
        "by_record_type",
        "by_source_type"
      ],
      "properties": {
        "by_league": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "by_record_type": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "by_source_type": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "generated_utc",
    "source_roots",
    "leagues",
    "entities",
    "measures",
    "qualifiers",
    "filters",
    "profiles",
    "relationships",
    "trace_index",
    "query_paths",
    "source_tree",
    "ui_views",
    "raw_sources"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "generated_utc": {
      "type": "string"
    },
    "source_roots": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "leagues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/semanticRecord"
      }
    },
    "measures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/semanticRecord"
      }
    },
    "qualifiers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/semanticRecord"
      }
    },
    "filters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/semanticRecord"
      }
    },
    "profiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/semanticRecord"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationshipRecord"
      }
    },
    "trace_index": {
      "$ref": "#/$defs/traceIndex"
    },
    "query_paths": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/queryPathRecord"
      }
    },
    "source_tree": {
      "$ref": "#/$defs/sourceTree"
    },
    "ui_views": {
      "$ref": "#/$defs/uiViews"
    },
    "raw_sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_files",
        "roots"
      ],
      "properties": {
        "total_files": {
          "type": "integer",
          "minimum": 0
        },
        "roots": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "exists",
              "file_count",
              "files"
            ],
            "properties": {
              "exists": {
                "type": "boolean"
              },
              "file_count": {
                "type": "integer",
                "minimum": 0
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
