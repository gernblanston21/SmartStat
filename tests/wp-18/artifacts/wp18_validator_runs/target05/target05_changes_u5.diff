+    def find_rule_eval(self, row: dict[str, Any], rule_id: str) -> dict[str, Any]:
+        for item in row["validation_result"]["rule_evaluations"]:
+            if str(item["rule_id"]) == rule_id:
+                return item
+        raise AssertionError(f"Missing rule evaluation: {rule_id}")
