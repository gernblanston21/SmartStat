+
+        operator_base = operator_base_from_slot(operator)
+        if operator_base == "rank" and terminal_cls != "terminal_measure":
+            issues.append(
+                make_issue(
+                    "SEM_FAMILY_OPERATOR_CONTEXT_INCOMPATIBLE",
+                    "Operator 'rank' requires terminal_measure context.",
