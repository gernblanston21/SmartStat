+    evaluations.append(dependency_eval)
+    errors.extend(dependency_errors)
+
+    formatter_eval, formatter_errors = evaluate_sem_formatter_terminal_adjacent_and_type_compatible(slots)
+    evaluations.append(formatter_eval)
