{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "SmartStat: Copy MAIN script to clipboard (latest in Main_TrioScript)",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        ".tools/copy-latest-main-to-clipboard.ps1",
        "-WorkspaceFolder",
        "${workspaceFolder}"
      ],
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "SmartStat: Export MAIN script to _EXPORT (latest in Main_TrioScript)",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        ".tools/export-latest-main-to-export.ps1",
        "-WorkspaceFolder",
        "${workspaceFolder}"
      ],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "SmartStat: Show lines (file + range)",
      "type": "shell",
      "command": "pwsh.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}\\.tools\\show-lines.ps1",
        "-Path", "${input:showLinesPath}",
        "-From", "${input:showLinesFrom}",
        "-To", "${input:showLinesTo}"
      ],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "SmartStat: PDF -> Chunked Markdown",
      "type": "shell",
      "command": "python",
      "args": [
        "${workspaceFolder}/tools/pdf_to_md_chunker.py",
        "--pdf",
        "${file}",
        "--out",
        "${workspaceFolder}/docs/viz-trio/_ingest"
      ],
      "problemMatcher": [],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "SmartStat: Viz Trio Preflight + PROMPTS",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "$paths=@(",
        "  'PROMPTS.md',",
        "  'docs/viz-trio/environment_constraints.md',",
        "  'docs/viz-trio/command_reference.md',",
        "  'docs/viz-trio/commands_full_index.md',",
        "  'docs/viz-trio/tabfields.md',",
        "  'docs/viz-trio/page_list.md',",
        "  'docs/viz-trio/page_editor.md',",
        "  'docs/viz-trio/show_control.md'",
        ");",
        "foreach($p in $paths){",
        "  if(Test-Path $p){ code -r $p } else { Write-Host ('MISSING: ' + $p) }",
        "}",
        "Write-Host 'Viz Trio preflight complete.'"
      ],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Skills: Validate TemplateConfig order",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.agents\\skills\\smartstat-ini-governance\\scripts\\validate_templateconfig_order.ps1",
        "-Path",
        "${workspaceFolder}\\SmartStat_TemplateConfig.ini"
      ],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Skills: Validate INI duplicates (TemplateConfig)",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.agents\\skills\\smartstat-ini-governance\\scripts\\validate_ini_no_duplicate_keys.ps1",
        "-Path",
        "${workspaceFolder}\\SmartStat_TemplateConfig.ini"
      ],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Skills: Determinism smoke",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.agents\\skills\\smartstat-determinism-audit\\scripts\\determinism_smoke.ps1",
        "-ScriptPath",
        "${workspaceFolder}\\SmartStat_v4.0.0_beta.vbs",
        "-OutDir",
        "${workspaceFolder}\\DiagLogs\\Harness",
        "-Tag",
        "det_smoke"
      ],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Roadmap: Status (mode + WP table)",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.agents\\skills\\smartstat-roadmap-driver\\scripts\\roadmap_status.ps1"
      ],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Roadmap: Next steps (RC vs Dev)",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.agents\\skills\\smartstat-roadmap-driver\\scripts\\roadmap_next_steps.ps1"
      ],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Repomix: Build SmartStat Core Pack",
      "type": "shell",
      "command": "repomix",
      "args": [],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Repomix: Build SmartStat Agents Pack",
      "type": "shell",
      "command": "repomix",
      "args": [
        "--include",
        "AGENTS.md,SESSION.md,ROADMAP.md,CHANGELOG.md,PROMPTS.md,docs/*,.agents/*",
        "-o",
        "repomix-smartstat-agents.xml"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Repomix: Build SmartStat Rules Pack",
      "type": "shell",
      "command": "repomix",
      "args": [
        "--include",
        "AGENTS.md,SESSION.md,ROADMAP.md,CHANGELOG.md,docs/ai/repomix-smartstat-instructions.md,.agents/**/*.md,.agents/**/*.ps1,governance/**/*.md",
        "-o",
        "repomix-smartstat-rules.xml"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Repomix: Build SmartStat Data Pack",
      "type": "shell",
      "command": "repomix",
      "args": [
        "--include",
        "AGENTS.md,SESSION.md,ROADMAP.md,docs/ai/repomix-smartstat-instructions.md,.agents/**/*.md,.agents/**/*.ps1,governance/**/*.md,docs/**/*.md",
        "-o",
        "repomix-smartstat-data.xml"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Repomix: Build SmartStat Delta Pack",
      "type": "shell",
      "command": "repomix",
      "args": [
        "--include-diffs",
        "--include-logs",
        "--include-logs-count",
        "10",
        "-o",
        "repomix-smartstat-delta.xml"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Repomix: Build SmartStat Truth Pack",
      "type": "shell",
      "command": "repomix",
      "args": [
        "--include",
        "SmartStat_v4.0.0_beta.vbs,SmartStat_v4.1.0.vbs,SmartStat_Mappings.ini,SmartStat_Mappings.learn.ini,SmartStat_MappingsNBA.ini,SmartStat_MappingsNBA.learn.ini,SmartStat_MappingsNHL.ini,SmartStat_MappingsNHL.learn.ini,SmartStat_StaticOverrides.ini,SmartStat_TemplateConfig.ini,docs/viz-trio/**/*.md,docs/onair/**/*.md,tests/**/*.md,tests/**/*.json,tests/**/*.txt,tests/**/*.ps1,tests/**/*.vbs",
        "-o",
        "repomix-smartstat-truth.xml"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Repomix: Build SmartStat Review Sandwich",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.tools\\build-repomix-review-sandwich.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ],
  "inputs": [
    {
      "id": "showLinesPath",
      "type": "promptString",
      "description": "Path to file"
    },
    {
      "id": "showLinesFrom",
      "type": "promptString",
      "description": "Start line"
    },
    {
      "id": "showLinesTo",
      "type": "promptString",
      "description": "End line"
    }
  ]
}
